# Supabase (Project Settings -> API)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used to build OAuth redirect URIs
PUBLIC_APP_URL=http://localhost:5173

# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (covers GA4, Search Console, YouTube)
# Redirect URIs (add all to the same OAuth client):
#   {PUBLIC_APP_URL}/api/integrations/google/callback
#   {PUBLIC_APP_URL}/api/integrations/google_ads/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app (covers Facebook Pages + Instagram Business)
# Valid OAuth redirect URIs (add both):
#   {PUBLIC_APP_URL}/api/integrations/meta/callback
#   {PUBLIC_APP_URL}/api/integrations/meta_ads/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Shared secret for the scheduled sync endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# true = run on built-in sample data, no Supabase needed. Never true in production.
DEMO_MODE=false

# Google Ads (optional). Uses the Google OAuth client above plus:
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# AI report assistant (optional; each is shown only when configured)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# Required for ChatGPT: the OpenAI model id your account should use
OPENAI_MODEL=
