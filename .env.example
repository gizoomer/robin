# Supabase (Project Settings -> API)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used to build OAuth redirect URIs
PUBLIC_APP_URL=http://localhost:5173

# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (covers GA4, Search Console, YouTube)
# Redirect URI: {PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app (covers Facebook Pages + Instagram Business)
# Redirect URI: {PUBLIC_APP_URL}/api/integrations/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Shared secret for the scheduled sync endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
